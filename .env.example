# Hardware mode is enabled by the Pi service. CLI defaults to demo.
DRIVECHECK_DEMO=false
DRIVECHECK_DATA_DIR=/var/lib/drivecheck
# Use SSH forwarding by default. For a trusted LAN dashboard, change to 0.0.0.0.
DRIVECHECK_HOST=127.0.0.1
DRIVECHECK_PORT=8765
# Optional fixed access key (minimum 16 characters); otherwise generated on disk.
# DRIVECHECK_API_KEY=
# Manual formatting and erase are available; every destructive action needs confirmation.
# Set false to hide destructive actions. Automatic intake always uses read-only Quick.
DRIVECHECK_ALLOW_DESTRUCTIVE=true
DRIVECHECK_SCAN_INTERVAL=5
# For an HTTPS reverse proxy, set its public origin and secure cookies.
# DRIVECHECK_PUBLIC_ORIGIN=https://drivecheck.example.com
DRIVECHECK_SECURE_COOKIE=false

# Fully unattended read-only intake: configure a provider, then set true.
DRIVECHECK_HEADLESS=false
# Optional environment-managed notifications (otherwise use dashboard Settings).
# DRIVECHECK_NOTIFICATION_PROVIDER=discord
# DRIVECHECK_DISCORD_WEBHOOK=https://discord.com/api/webhooks/ID/TOKEN
# Or: DRIVECHECK_NOTIFICATION_PROVIDER=telegram
# DRIVECHECK_TELEGRAM_TOKEN=BOT_ID:TOKEN
# DRIVECHECK_TELEGRAM_CHAT_ID=CHAT_ID
# Required for button controls in groups; private chat defaults to its user.
# DRIVECHECK_TELEGRAM_USER_ID=USER_ID
# Set PUBLIC_ORIGIN above to your reachable station URL for one-use sign-in links.
# Send a readiness notice after successful startup when notifications are enabled.
# DRIVECHECK_NOTIFY_READY=true
# Wait for result delivery before safe eject; queued notices still retry afterward.
DRIVECHECK_NOTIFICATION_WAIT_SECONDS=30
