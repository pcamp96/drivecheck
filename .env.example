# Hardware mode is enabled by the Pi service. CLI defaults to demo.
DRIVECHECK_DEMO=false
DRIVECHECK_DATA_DIR=/var/lib/drivecheck
# Use SSH forwarding by default. For a trusted LAN dashboard, change to 0.0.0.0.
DRIVECHECK_HOST=127.0.0.1
DRIVECHECK_PORT=8765
# Optional fixed access key (minimum 16 characters); otherwise generated on disk.
# DRIVECHECK_API_KEY=
# Full-drive writes stay disabled until deliberately armed and service restarted.
DRIVECHECK_ALLOW_DESTRUCTIVE=false
DRIVECHECK_SCAN_INTERVAL=5
# For an HTTPS reverse proxy, set its public origin and secure cookies.
# DRIVECHECK_PUBLIC_ORIGIN=https://drivecheck.example.com
DRIVECHECK_SECURE_COOKIE=false
