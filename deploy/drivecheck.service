[Unit]
Description=DriveCheck drive intake station
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/drivecheck
EnvironmentFile=/etc/drivecheck/drivecheck.env
ExecStart=/opt/drivecheck/.venv/bin/drivecheck --hardware
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/drivecheck
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Device access is necessary for raw read I/O and SMART ioctls.
# Do not enable PrivateDevices: it would hide the drive being tested.

[Install]
WantedBy=multi-user.target
